# Global Career Studio environment placeholders.
# Copy this file to .env for local work. Never commit a real .env file.
# Every value below is a placeholder only. No real secret is stored here.
# DATABASE_URL must point to a hosted Postgres database in later phases.
# No local Postgres is assumed. Do not invent a production URL here.
# Increment 13: the chosen hosted Postgres is Neon, free plan, region
# AWS EU Central Frankfurt (eu-central-1). The value below is a
# placeholder only. For Neon, use the pooled connection string from
# the Neon dashboard, added as a DATABASE_URL repo secret on GitHub
# and in the hosting environment, never pasted in chat or in any file.
# No live Neon database is connected yet.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require"
# DIRECT_URL is the direct, non-pooled Neon connection string, used
# by Prisma migrations only. The app runtime uses DATABASE_URL, the
# pooled string. Both are placeholders here, never real values.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require"
# Stripe, AI provider, storage, and auth secrets are NOT set in increment 1.
# They are added only when those open decisions are made, see PROJECT_STATUS.md.
# STRIPE_SECRET_KEY=""
# Increment 11: AI provider decided as Muse AI. Connected Muse AI is
# ready for a key and is NOT live until a key and a budget cap are set.
# Variable names only, no values, never commit a real key here.
# GCS_AI_PROVIDER="Muse AI"
# GCS_AI_MODEL=""
# GCS_AI_API_KEY=""
# GCS_AI_BUDGET_CAP=""
# NEXTAUTH_SECRET=""
